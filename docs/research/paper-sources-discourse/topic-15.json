10-15T12:14:09.886Z","reply_count":1,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":0,"reads":2,"readers_count":1,"score":5.4,"yours":false,"topic_id":15,"topic_slug":"why-search-is-broken-the-evidence","display_username":"turkhale","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"link_counts":[{"url":"https://Why","internal":false,"reflection":false,"clicks":1},{"url":"https://www.technologyreview.com/2023/10/03/1080659/why-big-techs-bet-on-ai-assistants-is-so-risky/","internal":false,"reflection":false,"title":"Why Big Tech's bet on AI assistants is so risky | MIT Technology Review","clicks":0}],"read":true,"user_title":null,"bookmarked":false,"actions_summary":[],"moderator":false,"admin":false,"staff":false,"user_id":2,"hidden":false,"trust_level":1,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":true,"wiki":false,"mentioned_users":[],"post_url":"/t/why-search-is-broken-the-evidence/15/2","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false},{"id":20,"name":"turkhale","username":"alex.turkhanov","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/a/3ab097/{size}.png","created_at":"2023-10-17T07:22:13.024Z","cooked":"\u003cp\u003e\u003ca href=\"https://www.coveo.com/en/resources/reports/relevance-report-workplace\" rel=\"noopener nofollow ugc\"\u003eWorkplace Relevance Report 2023\u003c/a\u003e\u003c/p\u003e\n\u003cp\u003eWe asked 4,000 Boomers, Gen Xers, Millennials, and Gen Zs what they expect from their digital workplace experiences. Here’s what you need to know to keep them empowered, enabled — and less likely to quit.\u003c/p\u003e\n\u003cp\u003e88% of employees feel demoralized when they can’t find the information they need to do their work. It’s even worse for younger workers.\u003c/p\u003e","post_number":3,"post_type":1,"posts_count":8,"updated_at":"2023-10-17T07:22:13.024Z","reply_count":0,"reply_to_post_number":2,"quote_count":0,"incoming_link_count":0,"reads":2,"readers_count":1,"score":0.4,"yours":false,"topic_id":15,"topic_slug":"why-search-is-broken-the-evidence","display_username":"turkhale","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"link_counts":[{"url":"https://www.coveo.com/en/resources/reports/relevance-report-workplace","internal":false,"reflection":false,"title":"Workplace Relevance Report 2023 | Coveo","clicks":1}],"read":true,"user_title":null,"reply_to_user":{"id":2,"username":"alex.turkhanov","name":"turkhale","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/a/3ab097/{size}.png"},"bookmarked":false,"actions_summary":[],"moderator":false,"admin":false,"staff":false,"user_id":2,"hidden":false,"trust_level":1,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":true,"wiki":false,"mentioned_users":[],"post_url":"/t/why-search-is-broken-the-evidence/15/3","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false},{"id":21,"name":"turkhale","username":"alex.turkhanov","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/a/3ab097/{size}.png","created_at":"2023-10-17T07:23:11.805Z","cooked":"\u003cp\u003e\u003ca href=\"https://cottrillresearch.com/various-survey-statistics-workers-spend-too-much-time-searching-for-information/\" rel=\"noopener nofollow ugc\"\u003eVarious Survey Statistics: Workers Spend Too Much Time Searching for Information\u003c/a\u003e\u003c/p\u003e\n\u003cp\u003e\u003ca href=\"https://cottrillresearch.com/various-survey-statistics-workers-spend-too-much-time-searching-for-information/\" rel=\"noopener nofollow ugc\"\u003eNOVEMBER 8, 2013\u003c/a\u003e\u003c/p\u003e\n\u003cp\u003eInformation overload is not going away. A recent \u003ca href=\"http://www.sla.org/guest-post-13-really-scary-number-youre-knowledge-worker/\" rel=\"noopener nofollow ugc\"\u003eIHS Knowledge Collections Webinar\u003c/a\u003e provided an interesting statistic by Outsell: an engineer’s time spent searching for information has increased 13% since 2002.\u003c/p\u003e\n\u003cp\u003eA new survey by SearchYourCloud \u003ca href=\"http://www.techzone360.com/topics/techzone/articles/2013/11/05/359192-searchyourcloud-survey-it-takes-up-8-attempts-find.htm\" rel=\"noopener nofollow ugc\"\u003erevealed\u003c/a\u003e “workers took up to 8 searches to find the right document and information.” Here are a few other statistics that help tell the tale of information overload and wasted time spent searching for correct information – either external or internal:\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\n\u003cp\u003e“According to a McKinsey report, employees spend 1.8 hours every day—9.3 hours per week, on average—searching and gathering information. Put another way, businesses hire 5 employees but only 4 show up to work; the fifth is off searching for answers, but not contributing any value.” \u003ca href=\"http://utrconf.com/top-3-reasons-why-we-spend-so-much-time-searching-for-information/\" rel=\"noopener nofollow ugc\"\u003eSource: Time Searching for Information\u003c/a\u003e.\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003e“19.8 per cent of business time – the equivalent of one day per working week – is wasted by employees searching for information to do their job effectively,” according to Interact. Source: \u003ca href=\"http://www.it-analysis.com/services/outsourcing/news_release.php?rel=38149\" rel=\"noopener nofollow ugc\"\u003eA Fifth of Business Time is Wasted Searching for Information, says Interact\u003c/a\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eIDC data shows that “the knowledge worker spends about 2.5 hours per day, or roughly 30% of the workday, searching for information….60% [of company executives] felt that time constraints and lack of understanding of how to find information were preventing their employees from finding the information they needed.” Source: \u003ca href=\"http://www.armedia.com/blog/2013/10/federated-search-the-importance-of-being-able-to-find-information/\" rel=\"noopener nofollow ugc\"\u003eInformation: The Lifeblood of the Enterprise\u003c/a\u003e.\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e","post_number":4,"post_type":1,"posts_count":8,"updated_at":"2023-10-17T07:23:11.805Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":4,"reads":2,"readers_count":1,"score":20.4,"yours":false,"topic_id":15,"topic_slug":"why-search-is-broken-the-evidence","display_username":"turkhale","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"link_counts":[{"url":"http://utrconf.com/top-3-reasons-why-we-spend-so-much-time-searching-for-information/","internal":false,"reflection":false,"title":"Top 3 Reasons Why We Spend So Much Time Searching for Information","clicks":4},{"url":"http://www.it-analysis.com/services/outsourcing/news_release.php?rel=38149","internal":false,"reflection":false,"clicks":2},{"url":"http://www.armedia.com/blog/2013/10/federated-search-the-importance-of-being-able-to-find-information/","internal":false,"reflection":false,"title":"Federated Search: The Importance of Being Able to Find Information - Armedia","clicks":2},{"url":"http://www.sla.org/guest-post-13-really-scary-number-youre-knowledge-worker/","internal":false,"reflection":false,"clicks":0},{"url":"http://www.techzone360.com/topics/techzone/articles/2013/11/05/359192-searchyourcloud-survey-it-takes-up-8-attempts-find.htm","internal":false,"reflection":false,"title":"SearchYourCloud Survey, It Takes up to 8 Attempts to Find an Accurate Search Result","clicks":0},{"url":"https://cottrillresearch.com/various-survey-statistics-workers-spend-too-much-time-searching-for-information/","internal":false,"reflection":false,"title":"Various Survey Statistics: Workers Spend Too Much Time Searching for Information – Cottrill Research, LLC","clicks":0}],"read":true,"user_title":null,"bookmarked":false,"actions_summary":[],"moderator":false,"admin":false,"staff":false,"user_id":2,"hidden":false,"trust_level":1,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":true,"wiki":false,"mentioned_users":[],"post_url":"/t/why-search-is-broken-the-evidence/15/4","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false},{"id":22,"name":"turkhale","username":"alex.turkhanov","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/a/3ab097/{size}.png","created_at":"2023-10-17T08:03:52.602Z","cooked":"\u003cp\u003e\u003ca href=\"https://www.forbes.com/sites/forbestechcouncil/2019/12/17/reality-check-still-spending-more-time-gathering-instead-of-analyzing/\" rel=\"noopener nofollow ugc\"\u003eReality Check: Still Spending More Time Gathering Instead Of Analyzing\u003c/a\u003e\u003c/p\u003e\n\u003cp\u003eNumerous studies of “knowledge worker” productivity have shown that we spend too much time gathering information instead of analyzing it. In 2001, IDC published its venerable white paper, “The High Cost of Not Finding Information,” noting that knowledge workers \u003ca href=\"https://computhink.com/wp-content/uploads/2015/10/IDC20on20The20High20Cost20Of20Not20Finding20Information.pdf\" rel=\"noopener nofollow ugc\"\u003ewere spending\u003c/a\u003e two and a half hours a day searching for information.\u003c/p\u003e\n\u003cp\u003eSince then, we have seen the rise of the cloud, ubiquitous computing, connectivity and everything else that was science fiction when we were kids becoming a reality — including the imminent emergence of AI. Yet in 2012, a decade after the IDC report, a \u003ca href=\"https://www.mckinsey.com/~/media/McKinsey/Industries/Technology%20Media%20and%20Telecommunications/High%20Tech/Our%20Insights/The%20social%20economy/MGI_The_social_economy_Full_report.ashx\" rel=\"noopener nofollow ugc\"\u003estudy\u003c/a\u003e conducted by McKinsey found that knowledge workers still spend 19% of their time searching for and gathering information, and a 2018 IDC study \u003ca href=\"https://pages.alteryx.com/rs/716-WAC-917/images/The%20State%20of%20Data%20Discovery%20%26%20Cataloging.pdf\" rel=\"noopener nofollow ugc\"\u003efound\u003c/a\u003e that “data professionals are losing 50% of their time every week” — 30% searching for, governing and preparing data plus 20% duplicating work.\u003c/p\u003e\n\u003cp\u003eClearly, all the technology advances have not flipped the productivity paradigm; it seems like we still spend more time searching for information that exists rather than analyzing and creating new knowledge.\u003c/p\u003e\n\u003cp\u003eThere are follow-up articles by the same author:\u003cbr\u003e\n\u003ca href=\"https://www.forbes.com/sites/forbestechcouncil/2020/03/24/sharing-an-effective-alternative-to-ineffective-search/\" rel=\"noopener nofollow ugc\"\u003eSharing: An Effective Alternative To (Ineffective) Search (forbes.com)\u003c/a\u003e\u003cbr\u003e\n\u003ca href=\"https://www.forbes.com/sites/forbestechcouncil/2020/05/22/accessing-applying-and-amplifying-knowledge/\" rel=\"noopener nofollow ugc\"\u003eAccessing, Applying and Amplifying Knowledge (forbes.com)\u003c/a\u003e\u003c/p\u003e","post_number":5,"post_type":1,"posts_count":8,"updated_at":"2023-10-17T09:05:49.611Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":0,"reads":2,"readers_count":1,"score":0.4,"yours":false,"topic_id":15,"topic_slug":"why-search-is-broken-the-evidence","display_username":"turkhale","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":2,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"link_counts":[{"url":"https://www.forbes.com/sites/forbestechcouncil/2020/03/24/sharing-an-effective-alternative-to-ineffective-search/","internal":false,"reflection":false,"title":"Sharing: An Effective Alternative To (Ineffective) Search","clicks":1},{"url":"https://www.forbes.com/sites/forbestechcouncil/2020/05/22/accessing-applying-and-amplifying-knowledge/","internal":false,"reflection":false,"title":"Accessing, Applying and Amplifying Knowledge","clicks":0},{"url":"https://pages.alteryx.com/rs/716-WAC-917/images/The%20State%20of%20Data%20Discovery%20%26%20Cataloging.pdf","internal":false,"reflection":false,"title":"Data Science and Analytics Automation Platform | Alteryx","clicks":0},{"url":"https://www.forbes.com/sites/forbestechcouncil/2019/12/17/reality-check-still-spending-more-time-gathering-instead-of-analyzing/","internal":false,"reflection":false,"title":"Reality Check: Still Spending More Time Gathering Instead Of Analyzing","clicks":0},{"url":"https://www.mckinsey.com/~/media/McKinsey/Industries/Technology%20Media%20and%20Telecommunications/High%20Tech/Our%20Insights/The%20social%20economy/MGI_The_social_economy_Full_report.ashx","internal":false,"reflection":false,"clicks":0},{"url":"https://computhink.com/wp-content/uploads/2015/10/IDC20on20The20High20Cost20Of20Not20Finding20Information.pdf","internal":false,"reflection":false,"clicks":0}],"read":true,"user_title":null,"bookmarked":false,"actions_summary":[],"moderator":false,"admin":false,"staff":false,"user_id":2,"hidden":false,"trust_level":1,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":true,"wiki":false,"mentioned_users":[],"post_url":"/t/why-search-is-broken-the-evidence/15/5","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false},{"id":23,"name":"turkhale","username":"alex.turkhanov","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/a/3ab097/{size}.png","created_at":"2023-10-17T09:06:38.608Z","cooked":"\u003cp\u003e\u003ca href=\"https://www.theatlantic.com/technology/archive/2021/06/the-internet-is-a-collective-hallucination/619320/\" rel=\"noopener nofollow ugc\"\u003eThe Rotting Internet Is a Collective Hallucination - The Atlantic\u003c/a\u003e\u003c/p\u003e\n\u003cp\u003eThat is the central piece; it is a collection of arguments and evidence.\u003c/p\u003e","post_number":6,"post_type":1,"posts_count":8,"updated_at":"2023-10-17T09:06:38.608Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":0,"reads":2,"readers_count":1,"score":0.4,"yours":false,"topic_id":15,"topic_slug":"why-search-is-broken-the-evidence","display_username":"turkhale","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"link_counts":[{"url":"https://www.theatlantic.com/technology/archive/2021/06/the-internet-is-a-collective-hallucination/619320/","internal":false,"reflection":false,"title":"The Rotting Internet Is a Collective Hallucination - The Atlantic","clicks":0}],"read":true,"user_title":null,"bookmarked":false,"actions_summary":[],"moderator":false,"admin":false,"staff":false,"user_id":2,"hidden":false,"trust_level":1,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":true,"wiki":false,"mentioned_users":[],"post_url":"/t/why-search-is-broken-the-evidence/15/6","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false},{"id":71,"name":"turkhale","username":"alex.turkhanov","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/a/3ab097/{size}.png","created_at":"2024-05-10T04:45:14.383Z","cooked":"\u003cp\u003e\u003ca href=\"https://www.x1.com/wp-content/uploads/2018/09/why_enterprise_search_fails.pdf\" rel=\"noopener nofollow ugc\"\u003eWP_S_ES_191501 (x1.com)\u003c/a\u003e\u003cbr\u003e\nThe traditional approach to enterprise search has focused on informational web search and Big Data use-cases, but those account for only 20% of the use-cases for enterprise search. It is no wonder that business workers cannot find anything – enterprise search has never focused on the core requirement of end-user business productivity.\u003cbr\u003e\n\u003cimg src=\"https://global.discourse-cdn.com/free1/uploads/terraphim/original/1X/97b449089e82d9d055b547af8147415327f927c4.jpeg\" alt=\"image\" data-base62-sha1=\"lE2maaMZAp2Gv9whNvSkgvNjnjS\" width=\"608\" height=\"400\"\u003e\u003c/p\u003e","post_number":7,"post_type":1,"posts_count":8,"updated_at":"2024-05-10T04:45:14.383Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":0,"reads":2,"readers_count":1,"score":0.4,"yours":false,"topic_id":15,"topic_slug":"why-search-is-broken-the-evidence","display_username":"turkhale","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"link_counts":[{"url":"https://www.x1.com/wp-content/uploads/2018/09/why_enterprise_search_fails.pdf","internal":false,"reflection":false,"clicks":0}],"read":true,"user_title":null,"bookmarked":false,"actions_summary":[],"moderator":false,"admin":false,"staff":false,"user_id":2,"hidden":false,"trust_level":1,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":true,"wiki":false,"mentioned_users":[],"post_url":"/t/why-search-is-broken-the-evidence/15/7","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false},{"id":78,"name":"turkhale","username":"alex.turkhanov","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/a/3ab097/{size}.png","created_at":"2024-06-17T07:28:32.330Z","cooked":"\u003caside class=\"onebox allowlistedgeneric\" data-onebox-src=\"https://www.pewresearch.org/data-labs/2024/05/17/when-online-content-disappears/\"\u003e\n  \u003cheader class=\"source\"\u003e\n      \u003cimg src=\"https://global.discourse-cdn.com/free1/uploads/terraphim/original/1X/9aa3468a7c74f339e5a6f2397244463ed1955068.svg\" class=\"site-icon\" alt=\"\" data-dominant-color=\"\" width=\"48\" height=\"48\"\u003e\n\n      \u003ca href=\"https://www.pewresearch.org/data-labs/2024/05/17/when-online-content-disappears/\" target=\"_blank\" rel=\"noopener nofollow ugc\" title=\"05:57PM - 17 May 2024\"\u003ePew Research Center – 17 May 24\u003c/a\u003e\n  \u003c/header\u003e\n\n  \u003carticle class=\"onebox-body\"\u003e\n    \u003cdiv class=\"aspect-image\" style=\"--aspect-ratio:690/387;\"\u003e\u003cimg src=\"https://global.discourse-cdn.com/free1/uploads/terraphim/original/1X/b664b5e53fac87ef31f68e70ef0020d16c6f273c.png\" class=\"thumbnail\" alt=\"\" data-dominant-color=\"FAF9F7\" width=\"690\" height=\"388\"\u003e\u003c/div\u003e\n\n\u003ch3\u003e\u003ca href=\"https://www.pewresearch.org/data-labs/2024/05/17/when-online-content-disappears/\" target=\"_blank\" rel=\"noopener nofollow ugc\"\u003eWhen Online Content Disappears\u003c/a\u003e\u003c/h3\u003e\n\n  \u003cp\u003eA quarter of all webpages that existed at one point between 2013 and 2023 are no longer accessible.\u003c/p\u003e\n\n  \u003cp\u003e\n    \u003cspan class=\"label1\"\u003eEst. reading time: 12 minutes\u003c/span\u003e\n  \u003c/p\u003e\n\n  \u003c/article\u003e\n\n  \u003cdiv class=\"onebox-metadata\"\u003e\n    \n    \n  \u003c/div\u003e\n\n  \u003cdiv style=\"clear: both\"\u003e\u003c/div\u003e\n\u003c/aside\u003e\n\n\u003ch1\u003e\u003ca name=\"p-78-when-online-content-disappears-1\" class=\"anchor\" href=\"#p-78-when-online-content-disappears-1\" aria-label=\"Heading link\"\u003e\u003c/a\u003eWhen Online Content Disappears\u003c/h1\u003e\n\u003ch2\u003e\u003ca name=\"p-78-h-38-of-webpages-that-existed-in-2013-are-no-longer-accessible-a-decade-later-2\" class=\"anchor\" href=\"#p-78-h-38-of-webpages-that-existed-in-2013-are-no-longer-accessible-a-decade-later-2\" aria-label=\"Heading link\"\u003e\u003c/a\u003e38% of webpages that existed in 2013 are no longer accessible a decade later\u003c/h2\u003e\n\u003cp\u003eBY \u003ca href=\"https://www.pewresearch.org/staff/athena-chapekis/\" rel=\"noopener nofollow ugc\"\u003eATHENA CHAPEKIS\u003c/a\u003e, \u003ca href=\"https://www.pewresearch.org/staff/samuel-bestvater/\" rel=\"noopener nofollow ugc\"\u003eSAMUEL BESTVATER\u003c/a\u003e, \u003ca href=\"https://www.pewresearch.org/staff/emma-remy/\" rel=\"noopener nofollow ugc\"\u003eEMMA REMY\u003c/a\u003e and \u003ca href=\"https://www.pewresearch.org/staff/gonzalo-rivero/\" rel=\"noopener nofollow ugc\"\u003eGONZALO RIVERO\u003c/a\u003e\u003c/p\u003e\n\u003cp\u003eThe internet is an unimaginably vast repository of modern life, with hundreds of billions of indexed webpages. But even as users across the world rely on the web to access books, images, news articles and other resources, this content sometimes disappears from view.\u003c/p\u003e\n\u003cp\u003eA new Pew Research Center analysis shows just how fleeting online content actually is:\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cstrong\u003eA quarter of all webpages that existed at one point between 2013 and 2023 are no longer accessible,\u003c/strong\u003e as of October 2023. In most cases, this is because an individual page was deleted or removed on an otherwise functional website.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003ca href=\"https://www.pewresearch.org/?attachment_id=167572\" rel=\"noopener nofollow ugc\"\u003e\u003cimg src=\"https://global.discourse-cdn.com/free1/uploads/terraphim/original/1X/e2a53f28e2afbda59b1f2911b09c26f631b2d5d8.png\" alt=\"A line chart showing that 38% of webpages from 2013 are no longer accessible\" data-base62-sha1=\"wkZWLgMRS48wdZa7htDq7lQcbI4\" width=\"583\" height=\"500\"\u003e\u003c/a\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cstrong\u003eFor older content, this trend is even starker.\u003c/strong\u003e Some 38% of webpages that existed in 2013 are not available today, compared with 8% of pages that existed in 2023.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003eThis “digital decay” occurs in many different online spaces. We examined the links that appear on government and news websites, as well as in the “References” section of Wikipedia pages as of spring 2023. This analysis found that:\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cstrong\u003e23% of news webpages contain at least one broken link, as do 21% of webpages from government sites.\u003c/strong\u003e News sites with a high level of site traffic and those with less are about equally likely to contain broken links. Local-level government webpages (those belonging to city governments) are especially likely to have broken links.\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003e54% of Wikipedia pages contain at least one link in their “References” section that points to a page that no longer exists.\u003c/strong\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003eTo see how digital decay plays out on social media, we also collected a real-time sample of tweets during spring 2023 on the social media platform X (then known as Twitter) and followed them for three months. We found that:\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cstrong\u003eNearly one-in-five tweets are no longer publicly visible on the site just months after being posted.\u003c/strong\u003e In 60% of these cases, the account that originally posted the tweet was made private, suspended or deleted entirely. In the other 40%, the account holder deleted the individual tweet, but the account itself still existed.\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003eCertain types of tweets tend to go away more often than others.\u003c/strong\u003e More than 40% of tweets written in Turkish or Arabic are no longer visible on the site within three months of being posted. And tweets from accounts with the default profile settings are especially likely to disappear from public view.\u003c/li\u003e\n\u003c/ul\u003e","post_number":8,"post_type":1,"posts_count":8,"updated_at":"2024-06-17T07:33:41.944Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":0,"reads":2,"readers_count":1,"score":0.4,"yours":false,"topic_id":15,"topic_slug":"why-search-is-broken-the-evidence","display_username":"turkhale","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":2,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"link_counts":[{"url":"https://www.pewresearch.org/data-labs/2024/05/17/when-online-content-disappears/","internal":false,"reflection":false,"title":"Link Rot and Digital Decay on Government, News and Other Webpages | Pew Research Center","clicks":1},{"url":"https://www.pewresearch.org/staff/samuel-bestvater/","internal":false,"reflection":false,"title":"Samuel Bestvater | Pew Research Center","clicks":0},{"url":"https://www.pewresearch.org/staff/athena-chapekis/","internal":false,"reflection":false,"clicks":0},{"url":"https://www.pewresearch.org/?attachment_id=167572","internal":false,"reflection":false,"title":"38% of webpages from 2013 are no longer accessible | Pew Research Center","clicks":0},{"url":"https://www.pewresearch.org/staff/gonzalo-rivero/","internal":false,"reflection":false,"title":"Gonzalo Rivero | Pew Research Center","clicks":0},{"url":"https://www.pewresearch.org/staff/emma-remy/","internal":false,"reflection":false,"title":"Emma Remy | Pew Research Center","clicks":0}],"read":true,"user_title":null,"bookmarked":false,"actions_summary":[],"moderator":false,"admin":false,"staff":false,"user_id":2,"hidden":false,"trust_level":1,"deleted_at":null,"user_deleted":false,"edit_reason":"downloaded local copies of images","can_view_edit_history":true,"wiki":false,"mentioned_users":[],"post_url":"/t/why-search-is-broken-the-evidence/15/8","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false}],"stream":[18,19,20,21,22,23,71,78]},"timeline_lookup":[[1,1077],[3,1075],[7,869],[8,831]],"suggested_topics":[],"tags":[],"tags_descriptions":{},"fancy_title":"Why search is broken - the evidence","id":15,"title":"Why search is broken - the evidence","posts_count":8,"created_at":"2023-10-15T12:13:05.094Z","views":158,"reply_count":1,"like_count":0,"last_posted_at":"2024-06-17T07:28:32.330Z","visible":true,"closed":false,"archived":false,"has_summary":false,"archetype":"regular","slug":"why-search-is-broken-the-evidence","category_id":4,"word_count":1354,"deleted_at":null,"user_id":2,"featured_link":null,"pinned_globally":false,"pinned_at":null,"pinned_until":null,"image_url":null,"slow_mode_seconds":0,"draft":null,"draft_key":"topic_15","draft_sequence":null,"unpinned":null,"pinned":false,"current_post_number":1,"highest_post_number":8,"deleted_by":null,"actions_summary":[{"id":4,"count":0,"hidden":false,"can_act":false},{"id":8,"count":0,"hidden":false,"can_act":false},{"id":10,"count":0,"hidden":false,"can_act":false},{"id":7,"count":0,"hidden":false,"can_act":false}],"chunk_size":20,"bookmarked":false,"topic_timer":null,"message_bus_last_id":0,"participant_count":1,"show_read_indicator":false,"thumbnails":null,"slow_mode_enabled_until":null,"related_topics":[{"fancy_title":"Terraphim use cases and re