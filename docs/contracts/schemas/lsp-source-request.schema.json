{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://terraphim.ai/schemas/lsp-source-request.schema.json",
  "title": "LSP source-request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "component",
    "version",
    "tag",
    "toolchain",
    "source",
    "recipe"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "component": {
      "const": "terraphim-lsp"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "tag": {
      "type": "string",
      "pattern": "^terraphim_lsp-v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?$"
    },
    "toolchain": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "tag",
        "requiredChecks"
      ],
      "properties": {
        "repository": {
          "const": "https://git.terraphim.cloud/terraphim/terraphim-ai"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "tag": {
          "type": "string",
          "pattern": "^terraphim_lsp-v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?$"
        },
        "requiredChecks": {
          "const": [
            "native-ci / build (push)",
            "native-clippy / lint (push)"
          ]
        }
      }
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "const": ".github/scripts/release/build_lsp_lane.py"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
