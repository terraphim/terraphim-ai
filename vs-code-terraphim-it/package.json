{
  "name": "terraphim-it",
  "displayName": "Terraphim It",
  "description": "Intelligent Markdown editor with alternatives, knowledge-graph synonyms and role-based suggestions",
  "version": "0.1.7",
  "publisher": "applied-knowledge-systems",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/terraphim/terraphim-ai"
  },
  "engines": {
    "vscode": "^1.126.0"
  },
  "categories": [
    "AI",
    "Other",
    "Snippets"
  ],
  "activationEvents": [
    "onCustomEditor:terraphimIt.alternativeControl"
  ],
  "main": "./out/extension",
  "contributes": {
    "commands": [
      {
        "command": "extension.terraphimCommand",
        "title": "Terraphim IT",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "extension.terraphimAIAutocomplete",
        "title": "Terraphim AI Autocomplete",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "extension.terraphimNapiAutocomplete",
        "title": "Terraphim Search Autocomplete (Server)",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "extension.terraphimServerAutocomplete",
        "title": "Terraphim Server Autocomplete",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "extension.terraphimHealthCheck",
        "title": "Terraphim Server Health Check",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "terraphimIt.openAlternativeControl",
        "title": "Terraphim: Open Alternative Control"
      },
      {
        "command": "terraphimIt.exportKnowledgeGraph",
        "title": "Terraphim: Export Document Knowledge Graph"
      },
      {
        "command": "terraphimIt.undo",
        "title": "Terraphim: Undo (Alternative Control)",
        "icon": "$(undo)"
      },
      {
        "command": "terraphimIt.redo",
        "title": "Terraphim: Redo (Alternative Control)",
        "icon": "$(redo)"
      }
    ],
    "configuration": {
      "title": "Terraphim IT",
      "properties": {
        "terraphimIt.agent": {
          "type": "string",
          "default": "",
          "description": "The agent to use for Terraphim IT"
        },
        "terraphimIt.serverUrl": {
          "type": "string",
          "default": "http://localhost:8000",
          "description": "Main Terraphim server URL for search and autocomplete"
        },
        "terraphimIt.atomicServerUrl": {
          "type": "string",
          "default": "https://common.terraphim.io/drive/h6grD0ID",
          "description": "Atomic server URL for accessing knowledge base resources"
        },
        "terraphimIt.enableLocalServer": {
          "type": "boolean",
          "default": true,
          "description": "Allow localhost and loopback server URLs. When disabled, set serverUrl to your remote Terraphim server; there is no automatic remote fallback."
        },
        "terraphimIt.selectedRole": {
          "type": "string",
          "default": "Terraphim Engineer",
          "description": "Default role to use for searches and autocomplete"
        }
      }
    },
    "customEditors": [
      {
        "viewType": "terraphimIt.alternativeControl",
        "displayName": "Terraphim Alternative Control",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "option"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "terraphimIt.undo",
          "when": "activeCustomEditorId == terraphimIt.alternativeControl",
          "group": "navigation@0"
        },
        {
          "command": "terraphimIt.redo",
          "when": "activeCustomEditorId == terraphimIt.alternativeControl",
          "group": "navigation@1"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "python3 scripts/editor_assets.py && python3 scripts/legacy_assets.py && npm run compile",
    "compile": "npx tsc -p ./",
    "lint": "eslint \"src/**/*.ts\"",
    "watch": "npx tsc -watch -p ./",
    "update-ontologies": "npx ad-generate ontologies",
    "build-rust": "python3 scripts/legacy_assets.py --build",
    "test:host": "node --test tests/hostProtocol.test.cjs tests/completionCache.test.cjs tests/checkpointStage.test.cjs tests/authorityRecovery.test.cjs tests/authorityDraftStage.test.cjs tests/resourceBackup.test.cjs tests/historyCommands.test.cjs tests/interactiveOpenDeadline.test.cjs",
    "test:assets": "python3 -m unittest discover -s tests -p \"*_test.py\"",
    "test:export": "node --test tests/knowledgeGraphExport.test.cjs tests/exportIntent.test.cjs tests/exportTarget.test.cjs",
    "editor:fetch": "python3 scripts/released_editor.py",
    "package:vsix": "vsce package --pre-release --out terraphim-it.vsix",
    "test:native": "node tests/runPackaged.cjs",
    "test:legacy": "node --test tests/legacyLinks.test.cjs",
    "test:shortcut-ui": "node tests/nativeStashShortcut.cjs",
    "test:notice-ui": "node --test tests/hostNotice.test.cjs tests/nativeEditableSelectAll.test.cjs",
    "test:history-checkpoint": "node --test tests/historyCheckpoint.test.cjs tests/historyCheckpoint.integration.test.cjs",
    "test:history-ui": "node tests/nativeAlternativeHistory.cjs",
    "test:authority": "node --test tests/resourceAuthority.test.cjs tests/resourceAuthorityNormalization.test.cjs",
    "test:authority-ui": "node tests/nativeAuthorityHistory.cjs",
    "test:authority-controllers": "node tests/runNativeAuthorityControllers.cjs"
  },
  "devDependencies": {
    "@types/node": "^20.16.10",
    "@types/vscode": "^1.73.0",
    "@typescript-eslint/eslint-plugin": "^7.14.0",
    "@typescript-eslint/parser": "^7.14.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "eslint": "^8.26.0",
    "ovsx": "1.2.0",
    "playwright-core": "1.62.1",
    "typescript": "^5.6",
    "yauzl": "3.4.0"
  },
  "dependencies": {
    "@tomic/cli": "0.40.0",
    "@tomic/lib": "0.40.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Alternative Control edits Markdown locally. Existing server and Atomic-resource commands require a trusted workspace."
    }
  }
}
